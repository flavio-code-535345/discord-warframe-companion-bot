{
  "name": "discord-warframe-companion-bot",
  "version": "1.0.0",
  "description": "Discord companion bot for the Warframe clan The Rats Den 69, with an MCP server for AI assistants",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/roboto": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@saschazar/wasm-webp": "3.0.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "discord.js": "^14.27.0",
    "express": "^5.3.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "pureimage": "0.4.20",
    "reflect-metadata": "^0.2.2",
    "tesseract.js": "^7.0.0",
    "warframe-worldstate-data": "^3.18.1",
    "warframe-worldstate-parser": "^5.5.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
