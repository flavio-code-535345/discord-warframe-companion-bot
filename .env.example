# --- Required ---
# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=
# Right-click the clan server icon → Copy Server ID (needs Developer Mode in Discord settings)
DISCORD_GUILD_ID=

# --- Clan ---
CLAN_NAME=The Rats Den 69
# Platform used for warframe.market prices: pc | ps4 | xbox | switch | mobile
WARFRAME_PLATFORM=pc

# --- MCP server (AI assistant access) ---
# Leave empty to disable /mcp. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_AUTH_TOKEN=
# Optional comma-separated Host header allow-list for /mcp. With the Docker stack use
# your BOT_DOMAIN plus localhost, e.g. bot.example.com,localhost,127.0.0.1
MCP_ALLOWED_HOSTS=

# --- Optional ---
# Greets new members in the /setup welcome channel. Also enable "Server Members Intent"
# under Bot → Privileged Gateway Intents in the Developer Portal, or login will fail.
ENABLE_WELCOME=false
WORLDSTATE_POLL_SECONDS=60

# --- Docker stack (docker-compose.yml) ---
# Image pushed by GitHub Actions, without tag
DOCKERHUB_IMAGE=yourname/rats-den-warframe-bot
# latest follows main; pin e.g. 1.2.0 to stop auto-updates at that version
BOT_TAG=latest
# Public DNS name pointing at the server; Caddy gets an HTTPS certificate for it (ports 80 and 443 must be reachable)
BOT_DOMAIN=bot.example.com
# Seconds between Watchtower checks for a new image
WATCHTOWER_POLL_INTERVAL=300
# Host port for local-only access to the bot (127.0.0.1)
BOT_LOCAL_PORT=3000

# --- Local development only (npm run dev); the container sets its own ---
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
DATA_DIR=./data
