# --- Required ---
# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=
# Right-click the clan server icon → Copy Server ID (needs Developer Mode in Discord settings)
DISCORD_GUILD_ID=

# --- Clan ---
CLAN_NAME=The Rats Den 69
# The bot sets this as its Discord username on startup (2-32 characters)
BOT_NAME=Cephalon Ordis
# Platform used for warframe.market prices: pc | ps4 | xbox | switch | mobile
WARFRAME_PLATFORM=pc

# --- MCP server (AI assistant access) ---
# Leave empty to disable /mcp. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_AUTH_TOKEN=
# Optional comma-separated Host header allow-list for /mcp. With the Docker stack use
# your BOT_DOMAIN plus localhost, e.g. bot.example.com,localhost,127.0.0.1
MCP_ALLOWED_HOSTS=

# --- Optional: Claude-powered chat ---
# Without a key, Ordis answers chat questions for free from live data and the wiki.
# A Claude API key (https://platform.claude.com, billed per question) upgrades that to real conversations.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default, best answers) · claude-sonnet-5-5 (cheaper) · claude-haiku-5-5 (cheapest)
AI_MODEL=claude-opus-5-5
# low | medium | high: how hard the model thinks before answering
AI_EFFORT=medium
# Let Ordis search the web (wiki, forums, patch notes) for things newer than its training
AI_WEB_SEARCH=true
# Spend limits: questions per member per hour, and for the whole server per UTC day
AI_USER_HOURLY_LIMIT=20
AI_DAILY_LIMIT=300
# Let Ordis read every message in the /setup chat channel. Also enable "Message Content Intent"
# under Bot → Privileged Gateway Intents in the Developer Portal, or login will fail.
# Not needed for @mentions, replies, /ask or DMs.
ENABLE_MESSAGE_CONTENT=false
# Audit log of member joins and leaves: needs the Server Members intent (Developer Portal -> Bot -> Privileged intents).
ENABLE_MEMBER_LOGGING=false
# Keep a local searchable copy of the Warframe wiki (about 50 MB in the data volume, refreshed daily) so Ordis
# answers most questions instantly from it. Set to false to always ask the live wiki instead.
WIKI_INDEX=true
# Optional FREE LLM that words the wiki answers instead of quoting them. Any OpenAI-compatible API with a free tier:
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai  (key from aistudio.google.com)  model gemini-flash-latest
#   Groq:   https://api.groq.com/openai/v1  (key from console.groq.com)  model openai/gpt-oss-120b
# It only ever sees the retrieved wiki excerpts. Without a key Ordis quotes the best sentences.
FREE_AI_KEY=
FREE_AI_URL=https://generativelanguage.googleapis.com/v1beta/openai
FREE_AI_MODEL=gemini-flash-latest
# Tried when the main model is busy or throttled (503/429)
FREE_AI_FALLBACK_MODEL=gemini-3.5-flash-lite
FREE_AI_DAILY_LIMIT=150
# Optional self-hosted model (Ollama), tried BEFORE the free cloud endpoint above, with no daily limit. If it is down or
# too slow it is skipped for 3 minutes and the cloud endpoint answers. Reach it over Tailscale or a tunnel, never an open port.
#   ollama serve (set OLLAMA_HOST=0.0.0.0 and OLLAMA_KEEP_ALIVE=24h on the host), then:
# LOCAL_AI_URL=http://100.64.0.1:11434/v1
# LOCAL_AI_MODEL=gemma4:26b-a4b   (the exact name from `ollama list`)
# LOCAL_AI_KEY=
# LOCAL_AI_TIMEOUT_SECONDS=60
# On-demand updates (the update_bot MCP tool). Pick any long random string for WATCHTOWER_TOKEN; the bot sends it
# to Watchtower inside the stack. Leave both empty to rely on Watchtower's normal polling only.
WATCHTOWER_URL=http://watchtower:8080
WATCHTOWER_TOKEN=

# Live Warframe data (fissures, alerts, cycles). Off while DE's CDN blocks our IP (HTTP 403 from api.warframe.com).
# Set WORLDSTATE_URL to a relay that serves the raw worldState.php from another IP, then WORLDSTATE_ENABLED=true.
WORLDSTATE_ENABLED=false
WORLDSTATE_URL=

# Live code patches over MCP (list_code_files, read_code_file, write_code_file, revert_code_file). Whoever holds
# MCP_AUTH_TOKEN can then run any code in the bot, so keep the token secret. Patches live in the data volume.
ALLOW_CODE_EDIT=false

# --- Web admin panel (https://<PUBLIC_URL>/admin) ---
# Developer Portal → OAuth2 → Client Secret. Also add <PUBLIC_URL>/admin/callback under OAuth2 → Redirects.
DISCORD_CLIENT_SECRET=
# The public address of the bot's website, e.g. https://ratsden.chiavino.de
PUBLIC_URL=
# Discord user IDs that are always admins (comma-separated); more admins are added in the panel
PANEL_OWNER_IDS=603293720061935626
# The only Discord IDs Ordis takes free-form instructions from (build design, theorycrafting): Legion and Tumba. Comma separated.
OPERATOR_IDS=220147375786688512,603293720061935626

# --- Optional ---
# Greets new members in the /setup welcome channel. Also enable "Server Members Intent"
# under Bot → Privileged Gateway Intents in the Developer Portal, or login will fail.
ENABLE_WELCOME=false
WORLDSTATE_POLL_SECONDS=600

# --- Docker stack (docker-compose.yml) ---
# Image pushed by GitHub Actions, without tag
DOCKERHUB_IMAGE=yourname/rats-den-warframe-bot
# latest follows main; pin e.g. 1.2.0 to stop auto-updates at that version
BOT_TAG=latest
# Public DNS name pointing at the server; Caddy gets an HTTPS certificate for it (ports 80 and 443 must be reachable)
BOT_DOMAIN=bot.example.com
# Seconds between Watchtower checks for a new image
WATCHTOWER_POLL_INTERVAL=300
# Host port for local-only access to the bot (127.0.0.1)
BOT_LOCAL_PORT=3000

# --- Local development only (npm run dev); the container sets its own ---
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
DATA_DIR=./data
